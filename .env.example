# Copy this file to ".env" (local) or set these as environment variables in your
# host's dashboard (deployment). ".env" is git-ignored — never commit real keys.
# Only the backend reads these. The static frontend/ and dashboard/ pages get
# their API URL from a constant at the top of their script, not from here.

# --- Required ---

# API key from the Anthropic Console. The backend won't answer chat without it.
ANTHROPIC_API_KEY=

# --- Optional: AI request ---

# Model id. Blank = backend default (claude-haiku-4-5).
AI_MODEL=

# Response cap and sampling. Blank = defaults (600 tokens, provider default temp).
AI_MAX_TOKENS=
AI_TEMPERATURE=

# Recent chat messages sent to the AI per turn. Blank = 12.
MAX_HISTORY_MESSAGES=

# --- Optional: server ---

# Port to listen on. Blank = 3000. Most hosts set PORT automatically.
PORT=

# The one origin allowed to call the API (e.g. https://cafebot.example.com).
# Blank = "*" (any origin). Not a list — set a single origin in production.
ALLOWED_ORIGIN=

# How long an idle chat session is kept in memory, in ms. Blank = 7200000 (2h).
SESSION_TTL_MS=

# --- Optional: order totals ---

# Sales tax as a fraction, e.g. 0.08 for 8%. Blank/0 = no tax.
TAX_RATE=

# Flat delivery fee added to delivery orders, e.g. 3.50. Blank/0 = free.
DELIVERY_FEE=
